{
  "vcs": {
    "template": "scripts/release/templates/release-commit-msg.hbs"
  },
  "package-manager": {
    "kind": "pnpm"
  },
  "report": {
    "bumps": {
      "patch": [
        { "type": "fix", "scope": "<package>" },
        { "type": "perf", "scope": "<package>" },
        { "type": "docs", "scope": "config", "packages": "*" }
      ]
    }
  }
}
