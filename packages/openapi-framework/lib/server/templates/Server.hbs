import { Route, HttpResponse, HttpStatus } from '@ibabkin/openapi-to-server';

// Components
{{#each components.schemas}}
  export type {{@key}} = {{render_template 'JsonSchema.hbs' this}};
{{/each}}

// Routes
{{#each paths as |path url|}}
  {{#each (get_methods_obj path)}}
    {{{render_template 'ServerRoute.hbs' this}}}
  {{/each}}
{{/each}}

// Operations
export type Operations = {
{{#each paths as |path url|}}
  {{#each (get_methods_obj path)}}
    {{operationId}}: {{route_name operationId}};
  {{/each}}
{{/each}}
}

export type RoutesPayloads = {
{{#each paths as |path url|}}
  {{#each (get_methods_obj path)}}
    {{operationId}}: {{payload_name operationId}};
  {{/each}}
{{/each}}
}

// Context
export interface RequestContext {
  getUrl<Key extends keyof RoutesPayloads>(key: Key, payload: RoutesPayloads[Key]): string;
}

// Controller Interfaces
{{#each (group_by_tags paths) as |operations tag|}}
/**
 * Controller interface for {{tag}} operations
 * Each method corresponds to an OpenAPI operation defined in swagger.yaml
 */
export interface {{controller_name tag}} {
  {{#each operations}}
  /**
   * {{operation.summary}}
   {{#if operation.description}}
   * {{operation.description}}
   {{/if}}
   * @param payload - Request payload including path params, query params, and body
   * @returns Promise with the operation response
   */
  {{operationId}}(payload: {{payload_name operationId}}): Promise<{{response_name operationId}}>;

  {{/each}}
}

{{/each}}
// Server Interface
export interface IServer {
{{#each (group_by_tags paths) as |operations tag|}}
  {{tag}}: {{controller_name tag}};
{{/each}}
}
