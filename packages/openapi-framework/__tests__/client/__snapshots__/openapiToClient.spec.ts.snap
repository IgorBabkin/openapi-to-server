// Jest Snapshot v1, https://goo.gl/fbAQLP

exports[`openapiToClient should generate client code from OpenAPI spec 1`] = `
"import { AxiosInstance, AxiosResponse } from 'axios';
import { createUrl, Payload } from '@ibabkin/openapi-to-server';

// Components
  export type Manufacturer = {
name: string  ;
homePage?: string  ;
phone?: string  ;
}
;
  export type InventoryItem = {
id: string  ;
name: string  ;
releaseDate: Date  ;
manufacturer: Manufacturer;
}
;

// Routes
    export type DeleteInventoryPayload = {
    params: {
  id: string  ,
}

};

export type DeleteInventoryResponse = void;

    export type AddInventoryPayload = {
    body: InventoryItem
};

export type AddInventoryResponse = InventoryItem;

    export type SearchInventoryPayload = {
    query: {
  searchString?: string  ,
  skip?: number
  ,
  limit?: number
  ,
}

};

export type SearchInventoryResponse =     InventoryItem[]
;



export class ApiClient {
  constructor(private httpClient: AxiosInstance) {
  }

  async deleteInventory(data: DeleteInventoryPayload): Promise<DeleteInventoryResponse> {
    const response = await this.httpClient.request({
      method: 'delete',
      url: createUrl('/inventory', data),
    });

    return response.data;
  }
  async addInventory(data: AddInventoryPayload): Promise<AddInventoryResponse> {
    const response = await this.httpClient.request({
      method: 'post',
      url: createUrl('/inventory', data),
      data: data.body,
    });

    return response.data;
  }
  async searchInventory(data: SearchInventoryPayload): Promise<SearchInventoryResponse> {
    const response = await this.httpClient.request({
      method: 'get',
      url: createUrl('/inventory', data),
    });

    return response.data;
  }
}
"
`;
