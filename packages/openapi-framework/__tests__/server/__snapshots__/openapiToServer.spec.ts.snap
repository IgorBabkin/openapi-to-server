  deleteInventory: DeleteInventoryRoute;
  addInventory: AddInventoryRoute;
  searchInventory: SearchInventoryRoute;
}

export type RoutesPayloads = {
  deleteInventory: DeleteInventoryPayload;
  addInventory: AddInventoryPayload;
  searchInventory: SearchInventoryPayload;
}

// Context
export interface RequestContext {
  getUrl<Key extends keyof RoutesPayloads>(key: Key, payload: RoutesPayloads[Key]): string;
}
// Controller Interfaces
  /**
  * Controller interface for developers operations
  * Each method corresponds to an OpenAPI operation defined in swagger.yaml
  */
  export interface IDevelopersController {
    /**
    * searches inventory
      * By passing in the appropriate options, you can search for
available inventory in the system

    * @param payload - Request payload including path params, query params, and body
    * @returns Promise with the operation response
    */
    searchInventory(payload: SearchInventoryPayload): Promise<SearchInventoryResponse>;

  }
  /**
  * Controller interface for admins operations
  * Each method corresponds to an OpenAPI operation defined in swagger.yaml
  */
  export interface IAdminsController {
    /**
    * adds an inventory item
      * Adds an item to the system
    * @param payload - Request payload including path params, query params, and body
    * @returns Promise with the operation response
    */
    addInventory(payload: AddInventoryPayload): Promise<AddInventoryResponse>;

    /**
    * deletes an inventory item
      * Deletes an item from the system
    * @param payload - Request payload including path params, query params, and body
    * @returns Promise with the operation response
    */
    deleteInventory(payload: DeleteInventoryPayload): Promise<DeleteInventoryResponse>;

  }
// Server Interface
export interface IServer {
  developers: constructor<IDevelopersController>;
  admins: constructor<IAdminsController>;
}
