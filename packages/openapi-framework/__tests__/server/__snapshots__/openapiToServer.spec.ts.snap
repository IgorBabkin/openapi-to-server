  status: HttpStatus.NoContent;

  headers: {
  };

}

export interface DeleteInventoryRoute extends Route<DeleteInventoryPayload, DeleteInventoryResponse> {}

    export type AddInventoryPayload = {
    body: InventoryItem
};

export interface AddInventoryResponse extends HttpResponse {
  status: HttpStatus.Found;

  headers: {
    Location: string  
  };

}

export interface AddInventoryRoute extends Route<AddInventoryPayload, AddInventoryResponse> {}

    export type SearchInventoryPayload = {
    query: {
  searchString?: string  ,
  skip?: number
  ,
  limit?: number
  ,
}

};

export interface SearchInventoryResponse extends HttpResponse {
  status: HttpStatus.OK;

  headers: {
  };

  body:     InventoryItem[]
;
}

export interface SearchInventoryRoute extends Route<SearchInventoryPayload, SearchInventoryResponse> {}


