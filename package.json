{
  "name": "root",
  "private": true,
  "author": "ibabkin <igba14@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "ci": "pnpm install --frozen-lockfile",
    "commit": "cz",
    "format": "prettier --write \"packages/**/*.ts\"",
    "format:check": "prettier --check \"packages/**/*.ts\"",
    "lint": "eslint packages/**/*.ts",
    "lint:fix": "pnpm lint --fix",
    "test": "pnpm -r run test",
    "build": "pnpm -r run build",
    "release:package-json": "monorepo-semantic-release package-json",
    "release:dry-run": "RELEASE_CONTEXT=$(monorepo-semantic-release report) && pnpm run release:package-json --dry-run --context \"$RELEASE_CONTEXT\" && monorepo-semantic-release package-manager --dry-run --context \"$RELEASE_CONTEXT\" && monorepo-semantic-release changelog --dry-run --context \"$RELEASE_CONTEXT\" && monorepo-semantic-release vcs --dry-run --context \"$RELEASE_CONTEXT\"",
    "prepare": "husky"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "3.9.7",
    "release-monorepo-semantically": "1.10.0"
  },
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.0"
}
