# Use workspace protocol by default
save-workspace-protocol=rolling

# Hoist patterns for tools that need root-level access
public-hoist-pattern[]=*eslint*
public-hoist-pattern[]=*prettier*
public-hoist-pattern[]=*typescript*
public-hoist-pattern[]=*jest*

# Strict peer dependencies
strict-peer-dependencies=true
auto-install-peers=true

# Shared workspace lockfile
shared-workspace-lockfile=true

# Enable side effects cache for faster builds
side-effects-cache=true

# Use hoisted linker (less strict than isolated, but more compatible)
node-linker=hoisted

# Resolution mode
resolution-mode=highest

# `pnpm version` (used by the release package-manager step) has no native pnpm
# implementation and is forwarded to `npm version`. Because the root package.json
# declares `workspaces` (required by release-monorepo-semantically for package
# discovery), npm then treats this as an npm workspace and reconciles it after the
# bump — failing on pnpm's `workspace:*` protocol. This repo is pnpm-only; turn it off.
workspaces-update=false
